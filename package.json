{
  "name": "objgauss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build-pr00.mjs",
    "build:pr01f": "node scripts/build-pr01-delivery.mjs",
    "contract:audit": "node scripts/audit-pr00.mjs",
    "contract:pr01a": "node scripts/audit-pr01a.mjs",
    "contract:pr02a": "node scripts/audit-pr02a.mjs",
    "test:preview": "node --test tests/external/gaussian-preview.test.mjs",
    "test:pr01d": "node --test tests/pr01d-audit.test.mjs",
    "test:pr01f": "node --test tests/pr01f-delivery.test.mjs",
    "test:pr02b": "node --test tests/pr02b-pilot.test.mjs",
    "test:pr02c": "node --test tests/pr02c-runtime.test.mjs",
    "test:pr02c-data": "node --test tests/pr02c-data.test.mjs",
    "test:pr02c-baselines": "node --test tests/pr02c-baselines.test.mjs",
    "test:pr02c-trainer": "node --test tests/pr02c-trainer.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "syntax": "node scripts/check-syntax.mjs",
    "verify:pr01f": "node scripts/verify-pr01-delivery.mjs",
    "check:pr02c-runtime": "./scripts/check-pr02c-runtime",
    "check:pr02c-data": "./scripts/check-pr02c-data",
    "check:pr02c-baselines": "./scripts/check-pr02c-baselines",
    "check:pr02c-trainer": "./scripts/check-pr02c-trainer",
    "check": "npm run build && npm run contract:audit && npm run contract:pr01a && npm run contract:pr02a && npm test && npm run syntax"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "esbuild": "0.28.1"
  }
}
