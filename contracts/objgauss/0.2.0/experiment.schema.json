{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sessgraph/ObjGauss/contracts/objgauss/0.2.0/experiment.schema.json",
  "title": "ObjGauss Sibling Experiment Manifest",
  "description": "Frozen design, split, action, retry, budget, and threshold policy for a sibling cohort.",
  "type": "object",
  "required": [
    "schema_version",
    "contract_kind",
    "identity",
    "source_gate",
    "contract_versions",
    "design",
    "actions",
    "split_policy",
    "preflight",
    "retry_policy",
    "budgets",
    "thresholds",
    "runtime",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "contract_kind": { "const": "objgauss.experiment" },
    "identity": { "$ref": "#/$defs/identity" },
    "source_gate": { "$ref": "#/$defs/sourceGate" },
    "contract_versions": { "$ref": "#/$defs/contractVersions" },
    "design": { "$ref": "#/$defs/design" },
    "actions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/actionSpec" }
    },
    "split_policy": { "$ref": "#/$defs/splitPolicy" },
    "preflight": { "$ref": "#/$defs/preflight" },
    "retry_policy": { "$ref": "#/$defs/retryPolicy" },
    "budgets": { "$ref": "#/$defs/budgets" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "claim_boundary": { "$ref": "#/$defs/claimBoundary" }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "identifierSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "seedSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "identity": {
      "type": "object",
      "required": ["experiment_id", "fixture_id", "experiment_spec_sha256"],
      "properties": {
        "experiment_id": { "$ref": "#/$defs/identifier" },
        "fixture_id": { "$ref": "#/$defs/identifier" },
        "experiment_spec_sha256": { "$ref": "#/$defs/sha256" }
      },
      "unevaluatedProperties": false
    },
    "sourceGate": {
      "type": "object",
      "required": ["status", "report_sha256", "evidence_sha256"],
      "properties": {
        "status": { "const": "supported" },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "evidence_sha256": { "$ref": "#/$defs/sha256" }
      },
      "unevaluatedProperties": false
    },
    "contractVersions": {
      "type": "object",
      "required": ["episode", "experiment", "attempt", "invariance_report"],
      "properties": {
        "episode": { "const": "0.2.0" },
        "experiment": { "const": "0.2.0" },
        "attempt": { "const": "0.2.0" },
        "invariance_report": { "const": "0.2.0" }
      },
      "unevaluatedProperties": false
    },
    "design": {
      "type": "object",
      "required": [
        "object_spec_ids",
        "layout_ids",
        "start_pose_ids",
        "reset_seeds",
        "expected_group_count",
        "expected_episode_count",
        "branches_per_group",
        "changed_variable"
      ],
      "properties": {
        "object_spec_ids": { "$ref": "#/$defs/identifierSet" },
        "layout_ids": { "$ref": "#/$defs/identifierSet" },
        "start_pose_ids": { "$ref": "#/$defs/identifierSet" },
        "reset_seeds": { "$ref": "#/$defs/seedSet" },
        "expected_group_count": { "type": "integer", "minimum": 1 },
        "expected_episode_count": { "type": "integer", "minimum": 1 },
        "branches_per_group": { "const": 5 },
        "changed_variable": { "const": "/intervention/commanded_action" }
      },
      "unevaluatedProperties": false
    },
    "actionSpec": {
      "type": "object",
      "required": ["branch_id", "kind", "vector_W_N", "duration_s", "sim_frequency_hz", "applied_steps"],
      "properties": {
        "branch_id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["hold", "push"] },
        "vector_W_N": { "$ref": "#/$defs/vector3" },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "sim_frequency_hz": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "applied_steps": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "unevaluatedProperties": false
    },
    "splitAllocation": {
      "type": "object",
      "required": ["train", "validation", "test"],
      "properties": {
        "train": { "type": "integer", "minimum": 1 },
        "validation": { "type": "integer", "minimum": 1 },
        "test": { "type": "integer", "minimum": 1 }
      },
      "unevaluatedProperties": false
    },
    "splitCounts": {
      "type": "object",
      "required": ["train_groups", "validation_groups", "test_groups", "train_episodes", "validation_episodes", "test_episodes"],
      "properties": {
        "train_groups": { "type": "integer", "minimum": 1 },
        "validation_groups": { "type": "integer", "minimum": 1 },
        "test_groups": { "type": "integer", "minimum": 1 },
        "train_episodes": { "type": "integer", "minimum": 1 },
        "validation_episodes": { "type": "integer", "minimum": 1 },
        "test_episodes": { "type": "integer", "minimum": 1 }
      },
      "unevaluatedProperties": false
    },
    "splitPolicy": {
      "type": "object",
      "required": ["unit", "algorithm", "strata", "seed_rank_allocation", "counts"],
      "properties": {
        "unit": { "const": "sibling_group" },
        "algorithm": { "const": "sha256-seed-rank-v1" },
        "strata": {
          "type": "array",
          "prefixItems": [
            { "const": "object_spec_id" },
            { "const": "layout_id" },
            { "const": "start_pose_id" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "seed_rank_allocation": { "$ref": "#/$defs/splitAllocation" },
        "counts": { "$ref": "#/$defs/splitCounts" }
      },
      "unevaluatedProperties": false
    },
    "preflight": {
      "type": "object",
      "required": ["excluded_from_formal_cohort", "start_pose_ids", "reserved_reset_seeds", "expected_group_count", "expected_episode_count", "freezes"],
      "properties": {
        "excluded_from_formal_cohort": { "const": true },
        "start_pose_ids": { "$ref": "#/$defs/identifierSet" },
        "reserved_reset_seeds": { "$ref": "#/$defs/seedSet" },
        "expected_group_count": { "type": "integer", "minimum": 1 },
        "expected_episode_count": { "type": "integer", "minimum": 1 },
        "freezes": {
          "type": "array",
          "prefixItems": [
            { "const": "branch_timeout_s" },
            { "const": "contact_settling_effect_thresholds" },
            { "const": "p95_runtime_s" },
            { "const": "p95_artifact_bytes" },
            { "const": "formal_resource_budget" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      },
      "unevaluatedProperties": false
    },
    "retryPolicy": {
      "type": "object",
      "required": ["max_retries_per_branch", "max_extra_attempts", "retryable_classes", "non_retryable_classes", "forbid_seed_replacement"],
      "properties": {
        "max_retries_per_branch": { "const": 1 },
        "max_extra_attempts": { "type": "integer", "minimum": 0 },
        "retryable_classes": {
          "type": "array",
          "prefixItems": [
            { "const": "simulator_crash" },
            { "const": "startup_timeout" },
            { "const": "atomic_write_failure" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "non_retryable_classes": {
          "type": "array",
          "prefixItems": [
            { "const": "no_contact" },
            { "const": "not_settled" },
            { "const": "action_mismatch" }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "forbid_seed_replacement": { "const": true }
      },
      "unevaluatedProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["branch_timeout_s", "formal_wall_time_max_s", "formal_artifact_bytes_max", "process_rss_max_bytes", "extra_attempt_fraction_max"],
      "properties": {
        "branch_timeout_s": { "type": "number", "exclusiveMinimum": 0 },
        "formal_wall_time_max_s": { "type": "number", "exclusiveMinimum": 0 },
        "formal_artifact_bytes_max": { "type": "integer", "minimum": 1 },
        "process_rss_max_bytes": { "type": "integer", "minimum": 1 },
        "extra_attempt_fraction_max": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "unevaluatedProperties": false
    },
    "thresholds": {
      "type": "object",
      "required": ["hold_horizontal_drift_max_m", "directional_effect_min_m", "strong_over_weak_min_m", "final_linear_speed_max_m_s", "final_angular_speed_max_rad_s"],
      "properties": {
        "hold_horizontal_drift_max_m": { "type": "number", "minimum": 0 },
        "directional_effect_min_m": { "type": "number", "minimum": 0 },
        "strong_over_weak_min_m": { "type": "number", "minimum": 0 },
        "final_linear_speed_max_m_s": { "type": "number", "minimum": 0 },
        "final_angular_speed_max_rad_s": { "type": "number", "minimum": 0 }
      },
      "unevaluatedProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["python", "mani_skill", "sapien", "torch", "backend", "lock_uri", "lock_sha256", "asset_policy", "network_policy"],
      "properties": {
        "python": { "type": "string", "minLength": 1, "maxLength": 32 },
        "mani_skill": { "type": "string", "minLength": 1, "maxLength": 32 },
        "sapien": { "type": "string", "minLength": 1, "maxLength": 32 },
        "torch": { "type": "string", "minLength": 1, "maxLength": 48 },
        "backend": { "enum": ["physx_cpu", "physx_cuda"] },
        "lock_uri": { "$ref": "#/$defs/artifactPath" },
        "lock_sha256": { "$ref": "#/$defs/sha256" },
        "asset_policy": { "const": "builtin-primitives-only" },
        "network_policy": { "const": "offline-at-runtime" }
      },
      "unevaluatedProperties": false
    },
    "claimBoundary": {
      "type": "object",
      "required": ["allows", "forbids"],
      "properties": {
        "allows": {
          "type": "array",
          "prefixItems": [
            { "const": "programmatic-cpu-primitive-sibling-evidence" }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "forbids": {
          "type": "array",
          "prefixItems": [
            { "const": "model-training" },
            { "const": "gaussian-dynamics" },
            { "const": "external-data" },
            { "const": "rgb-gpu-renderer" },
            { "const": "robot-control" }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        }
      },
      "unevaluatedProperties": false
    }
  }
}
